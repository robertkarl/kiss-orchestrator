#!/bin/bash
# Launch a subtask agent in an isolated git worktree.
#
# Usage: subtask-launch <slug> [-f <prompt-file>] [--repo <path>] [--base <ref>] [<newclaude args>...]
#
# By default, operates on the git repo containing the current directory.
# Creates .worktrees/<slug> worktree on branch subtask/<slug>, prunes stale
# worktrees first, then launches newclaude in it with --agent subtask_agent.
# The new branch is created from --base (default: current HEAD).

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: subtask-launch <slug> [-f <prompt-file>] [--repo <path>] [--base <ref>] [<newclaude args>...]

Creates .worktrees/<slug> worktree on branch subtask/<slug>, prunes stale
worktrees first, then launches newclaude in it. Extra args are passed
through to newclaude.

Options:
  -h, --help    Show this help and exit
  --repo PATH   Override repo root (default: git toplevel of CWD)
  --base REF    Branch the worktree from REF (default: current HEAD),
                e.g. --base master or --base origin/master
  --no-warm     Skip the post-create worktree warm step
  --warm-args A Args passed to the repo's scripts/setup-worktree.sh
                (default: "--ml"); the warm step only runs if that
                script exists, so this is a no-op in repos without it
EOF
}

if [[ $# -lt 1 ]]; then
    usage >&2
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
fi

slug="$1"
shift

if [[ "$slug" == -* ]]; then
    echo "subtask-launch: slug must not begin with '-' (got '${slug}')" >&2
    echo "Run 'subtask-launch --help' for usage." >&2
    exit 2
fi

# Parse --repo and --base from remaining args, pass the rest through to newclaude
REPO_DIR=""
BASE="HEAD"
WARM=1
WARM_ARGS="--ml"
passthrough=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)
            REPO_DIR="$(cd "$2" && pwd)"
            shift 2
            ;;
        --base)
            BASE="$2"
            shift 2
            ;;
        --no-warm)
            WARM=0
            shift
            ;;
        --warm-args)
            WARM_ARGS="$2"
            shift 2
            ;;
        *)
            passthrough+=("$1")
            shift
            ;;
    esac
done

if [[ -z "$REPO_DIR" ]]; then
    if ! REPO_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        echo "subtask-launch: not inside a git repo and no --repo given" >&2
        exit 2
    fi
fi

# Validate the base ref resolves to a commit in the repo
if ! git -C "${REPO_DIR}" rev-parse --verify --quiet "${BASE}^{commit}" >/dev/null; then
    echo "subtask-launch: base ref '${BASE}' not found in ${REPO_DIR}" >&2
    exit 2
fi

worktree="${REPO_DIR}/.worktrees/${slug}"
branch="subtask/${slug}"

echo "Preparing worktree (new branch '${branch}')"

# Prune stale worktrees
git -C "${REPO_DIR}" worktree prune 2>/dev/null

# Clean up if this slug was used before
if git -C "${REPO_DIR}" worktree list --porcelain | grep -q "worktree ${worktree}$"; then
    echo "Removing existing worktree ${worktree}" >&2
    git -C "${REPO_DIR}" worktree remove --force "${worktree}" 2>/dev/null || true
fi
if git -C "${REPO_DIR}" show-ref --verify --quiet "refs/heads/${branch}"; then
    git -C "${REPO_DIR}" branch -D "${branch}" 2>/dev/null || true
fi

# Create worktree on new branch from the base ref
mkdir -p "${REPO_DIR}/.worktrees"
git -C "${REPO_DIR}" worktree add "${worktree}" -b "${branch}" "${BASE}"
echo "Worktree: ${worktree} (branch: ${branch}, base: ${BASE})"

# Warm the worktree if the repo ships a bootstrap script (e.g. mythos:
# node_modules + cargo fetch, plus uv sync + ml data symlinks with --ml). Runs
# BEFORE the agent launches so the subtask boots into a warm env. Gated on the
# script existing, so this is a no-op in repos without it. Non-fatal: a warm
# failure still launches the subtask.
if [[ "${WARM}" == "1" && -f "${worktree}/scripts/setup-worktree.sh" ]]; then
    echo "Warming worktree: scripts/setup-worktree.sh ${WARM_ARGS}" >&2
    if ! ( cd "${worktree}" && bash scripts/setup-worktree.sh ${WARM_ARGS} ) >&2; then
        echo "subtask-launch: warm step failed — launching anyway (run scripts/setup-worktree.sh manually inside the worktree)" >&2
    fi
fi

# Launch subtask. Disable Task* tools so the periodic task-tools system
# reminder doesn't burn tokens every turn — subtasks rarely need TODO tracking.
newclaude "${worktree}" --agent subtask_agent \
    --env CLAUDE_CODE_ENABLE_TASKS=false \
    ${passthrough[@]+"${passthrough[@]}"}
